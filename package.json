{
  "name": "@tokener-ai/dsh-tokener-provider",
  "version": "0.1.0-beta.1",
  "description": "Tokener model provider for DeepSeek Harness",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js"
  },
  "files": [
    "index.mjs",
    "lib/client*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": "github:tokener-ai/dsh-tokener-provider",
  "homepage": "https://tokener.ai",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tokener"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "pnpm test && pnpm build && node --check lib/client.js",
    "prepack": "pnpm check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
